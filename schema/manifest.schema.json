{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmavito.github.io/cra-trail/schema/manifest.schema.json",
  "title": "cra-trail evidence pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generator", "rulesVersion", "product", "source", "signing", "createdAt", "tools", "files"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "generator": { "$ref": "#/$defs/nameVersion" },
    "rulesVersion": { "type": "string", "minLength": 1 },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "purl"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "purl": { "type": ["string", "null"] }
      }
    },
    "source": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["repository", "commit", "ref", "workflowRef", "runId"],
      "properties": {
        "repository": { "type": ["string", "null"] },
        "commit": { "type": ["string", "null"] },
        "ref": { "type": ["string", "null"] },
        "workflowRef": { "type": ["string", "null"] },
        "runId": { "type": ["string", "null"] }
      }
    },
    "signing": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["method", "signerWorkflow"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "signerWorkflow": { "type": ["string", "null"] }
      }
    },
    "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "tools": { "type": "array", "items": { "$ref": "#/$defs/nameVersion" } },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" } }
  },
  "$defs": {
    "nameVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "mediaType", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[^/\\\\:][^\\\\:]*$" },
        "kind": {
          "enum": [
            "product", "evaluation", "product-sbom", "sbom", "vex", "grype", "sast-sarif", "secrets-sarif",
            "cvd-policy", "attested-document", "test-results", "sbom-quality", "nuget-audit", "npm-audit-signatures"
          ]
        },
        "mediaType": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
