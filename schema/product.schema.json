{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmavito.github.io/cra-trail/schema/product.schema.json",
  "title": "cra-trail product information (product.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "purl", "supportEnd", "cvdContact", "securityTxt", "userInfo", "attested", "notApplicable", "checkOverrides", "gateInclude", "gateExclude"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "purl": { "type": ["string", "null"] },
    "supportEnd": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "cvdContact": { "type": ["string", "null"] },
    "securityTxt": { "type": ["string", "null"], "pattern": "^https://" },
    "userInfo": { "type": "object", "additionalProperties": { "type": "string" } },
    "attested": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^attested/" } },
    "notApplicable": { "type": "object", "additionalProperties": { "type": "string" } },
    "checkOverrides": { "type": "object", "additionalProperties": { "type": "object" } },
    "gateInclude": { "type": "array", "items": { "type": "string" } },
    "gateExclude": { "type": "array", "items": { "type": "string" } }
  }
}
